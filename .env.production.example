# Production settings, read by `npm run build`, deploy/deploy.sh and the overlay app's build.
# Copy this file to .env.production (not committed) and fill it in.

# Supabase project, from its dashboard (Project Settings > API). Both values are public by design:
# they end up in the site's code, and the lists table is closed to them (see supabase/migrations).
# Never put the service_role (secret) key or the database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public address of the site, an https origin without a trailing slash (e.g. https://dune.example.com).
# The overlay app is built against it.
SITE_URL=

# Where deploy/deploy.sh publishes the site: an SSH host (an alias from ~/.ssh/config works), the
# directory on that server, and the Docker network of the reverse proxy that serves SITE_URL over HTTPS.
DEPLOY_HOST=
DEPLOY_DIR=
DEPLOY_NETWORK=
