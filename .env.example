# Supabase project used for guild lists. Without these, the site works as a
# personal calculator only (the Share button is hidden).
#
# Local development: `npx supabase start`, then these values (the local stack's
# public demo key, the same on every machine):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#
# Cloud project: its URL and its publishable (public) key, from the Supabase
# dashboard (Project Settings > API). Copy this file to .env.local. Production
# builds read .env.production instead, see .env.production.example.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
