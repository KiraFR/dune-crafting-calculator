{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dune Overlay",
  "version": "0.3.2",
  "identifier": "dune-crafting-calculator.overlay",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "Dune Crafting Calculator",
    "shortDescription": "Overlay for the Dune: Awakening crafting calculator",
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODA0RTE4Mjc1QjlERDIKUldUU25Wc25HRTZBbzkrS2ZPNkUzYk9nS3VZbVd5T24zRnRQODZkS2RyNWY5WnVJdHBsaFRyNXMK",
      "endpoints": ["https://github.com/KiraFR/dune-crafting-calculator/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
